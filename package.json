{
  "name": "eaa-cite",
  "version": "0.1.0",
  "description": "European Accessibility Act obligations per member state, every claim tied to its article, plus an MCP server that maps axe-core results to EN 301 549.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "eaa-cite-mcp": "./dist/mcp/bin.js",
    "eaa-cite": "./dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./scan": "./dist/scan/index.js",
    "./scan/browser": "./dist/scan/browser.js"
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "DATA-LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx src/mcp/bin.ts",
    "build:criteria": "tsx scripts/build-criteria.ts",
    "verify-sources": "tsx scripts/verify-sources.ts",
    "demo": "tsx scripts/demo.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "try": "tsx scripts/try-test-shop.ts",
    "cli": "tsx src/cli/main.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "accessibility",
    "eaa",
    "en-301-549",
    "wcag",
    "axe-core",
    "mcp",
    "model-context-protocol"
  ],
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pdfjs-dist": "^6.5.438",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
